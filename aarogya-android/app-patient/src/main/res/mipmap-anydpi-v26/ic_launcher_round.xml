<?xml version="1.0" encoding="utf-8"?>
<!-- Identical to ic_launcher.xml: an adaptive icon's background and
     foreground are already mask-agnostic (the OS clips them to whatever
     shape, circle, squircle, round-rect, the launcher wants), so there's
     no separate "round" artwork to author; this file exists only because
     android:roundIcon is a required manifest attribute on some launchers. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
