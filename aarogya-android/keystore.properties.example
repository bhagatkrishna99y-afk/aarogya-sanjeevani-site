# Copy this file to keystore.properties (repo root) and fill in your real
# values to sign a local release build. keystore.properties is gitignored --
# never commit the real file.
#
# storeFile is resolved relative to the repo root if it's a relative path.
# CI never reads this file -- it builds the same four values from its own
# encrypted secrets instead (see .github/workflows/release.yml); this file
# is for signing a release build on your own machine.

storeFile=keystore/patient-rc.jks
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password
