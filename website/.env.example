# The contact form on /contact POSTs here as JSON ({name, email, message}),
# Accept: application/json. This site has no backend of its own to receive
# it, so this points at a third-party form-to-email service -- Formspree
# (https://formspree.io) is a zero-backend option that fits a static site
# like this one; replace REPLACE_WITH_REAL_FORM_ID with a real form ID
# before going live. See src/lib/contactForm.ts.
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/REPLACE_WITH_REAL_FORM_ID
