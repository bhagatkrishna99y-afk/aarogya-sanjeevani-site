<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every "https://example.com" below is replaced with the real
  VITE_SITE_URL automatically at build time (see vite.config.ts's
  patchSeoFilesWithSiteUrl plugin) -- editing the <loc> values here by
  hand is not needed, and will just get overwritten by the next build.
  Edit VITE_SITE_URL in .env (or the deploy environment) instead.
  /admin* is intentionally excluded from this file: it's gated by
  sign-in and has nothing for a crawler to index.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://example.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://example.com/services</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://example.com/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://example.com/contact</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://example.com/privacy-policy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://example.com/terms</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
